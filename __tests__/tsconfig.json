{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "vitest": ["node_modules/vitest"]
    }
  },
  "include": [
    "**/*.ts",
    "../server/src/**/*.ts"
  ],
  "exclude": [
    "e2e/strapi-app/**"
  ]
}
